# Barakah Agro backend settings
PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Hostinger MySQL: use the exact host, database, and username shown in hPanel
DB_HOST=your-hostinger-mysql-hostname
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_CONNECTION_LIMIT=5

# Optional: keep your existing Gemini configuration if you use it
GEMINI_API_KEY=your_gemini_api_key
APP_URL=http://localhost:3000
PRIVATE_COUPON_CODE=
PRIVATE_COUPON_PERCENT=
